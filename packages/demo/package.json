{
  "name": "demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Demo page and Storybook for @burntlotuslabs/aria-ui-kit. Consumes the library through the workspace link, like an app would.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist storybook-static",
    "test:stories": "vitest run --project storybook",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@burntlotuslabs/aria-ui-kit": "workspace:*",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9.1.0",
    "@storybook/addon-docs": "^9.1.0",
    "@storybook/addon-vitest": "^9.1.20",
    "@storybook/react-vite": "^9.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser": "^3.2.7",
    "axe-core": "^4.10.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.0",
    "storybook": "^9.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
