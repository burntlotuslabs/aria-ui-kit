{
  "name": "@burntlotuslabs/aria-ui-kit",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A small component system built on react-aria-components: form fields, overlays, tabs, toasts, themeable tokens, and an accessible sortable/filterable table.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burntlotuslabs/aria-ui-kit.git",
    "directory": "packages/aria-ui-kit"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./src/theme/tokens.css"
  },
  "files": [
    "dist",
    "src/theme/tokens.css",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish:beta:dry-run": "npm publish --tag beta --dry-run",
    "clean": "rm -rf dist",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "vitest run --coverage --coverage.reporter=text-summary"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-aria-components": "^1.22.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "axe-core": "^4.10.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.0"
  }
}
