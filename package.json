{
  "name": "aria-ui-kit-workspace",
  "private": true,
  "type": "module",
  "description": "Workspace root for @burntlotuslabs/aria-ui-kit and its demo/Storybook app",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "storybook": "pnpm --filter demo storybook",
    "build": "pnpm build:library && pnpm --filter demo build",
    "build:library": "pnpm --filter @burntlotuslabs/aria-ui-kit build",
    "typecheck": "pnpm build:library && pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean",
    "prepare": "husky",
    "test:coverage": "pnpm -r test:coverage",
    "test:coverage:ci": "pnpm -r test:coverage:ci",
    "test:library": "pnpm --filter @burntlotuslabs/aria-ui-kit test",
    "dev:storybook": "pnpm --filter demo storybook",
    "build:storybook": "pnpm --filter demo build-storybook",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:smoke": "pnpm build:library && pnpm --filter next-smoke build && pnpm --filter next-smoke test:smoke",
    "test:stories": "pnpm --filter demo test:stories"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
